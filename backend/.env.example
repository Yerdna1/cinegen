# Database
# For development (SQLite):
# DATABASE_URL="file:./dev.db"

# For production (Neon PostgreSQL):
# Get your connection strings from: https://console.neon.tech
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
DIRECT_URL="postgresql://user:password@host/database?sslmode=require"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRY="7d"

# Server
PORT=3001
NODE_ENV=development

# Email (for development - use console transport)
EMAIL_FROM="noreply@cinegen.local"
SMTP_HOST="localhost"
SMTP_PORT=1025

# Encryption key for API keys (32 bytes hex)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Frontend URL for CORS
FRONTEND_URL="http://localhost:3000"

# Backend URL (for generating full URLs to uploaded files)
# Set to your Vercel deployment URL in production
BACKEND_URL="http://localhost:3001"

# Vercel Blob Storage (for production file uploads)
# Create a blob store at: https://vercel.com/dashboard/stores
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Kling AI API Keys (for video generation)
# Get your keys from: https://klingai.com
KLING_ACCESS_KEY="your-kling-access-key"
KLING_SECRET_KEY="your-kling-secret-key"

# PiAPI (Kling via membership credits)
PIAPI_KEY="your-piapi-key"

# Claude Authentication (choose one method)
#
# Option 1: Claude Code OAuth Token (RECOMMENDED - uses your Claude subscription)
# Get your token by running: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN="your-oauth-token-from-claude-setup-token"
#
# Option 2: Anthropic API Key (separate API credits)
# Get your key from: https://console.anthropic.com
ANTHROPIC_API_KEY="your-anthropic-api-key"
#
# Claude model to use (optional, defaults to claude-sonnet-4-5-20250929)
CLAUDE_MODEL="claude-sonnet-4-5-20250929"

# Modal.com API (for self-hosted AI models)
# Configure your Modal endpoints after deploying your models
MODAL_API_KEY="your-modal-api-key"
MODAL_LLM_ENDPOINT="https://your-modal-llm.modal.run"
MODAL_IMAGE_ENDPOINT="https://your-modal-image.modal.run"

# Google Gemini API (for image generation via NanoBanana provider)
# Get your key from: https://aistudio.google.com/apikey
GOOGLE_GEMINI_API_KEY="your-gemini-api-key"

# Modal.com TTS Endpoints (for self-hosted TTS models)
# Deploy F5-TTS and Chatterbox on Modal, then add endpoints here
MODAL_F5TTS_ENDPOINT="https://your-f5tts.modal.run"
MODAL_CHATTERBOX_ENDPOINT="https://your-chatterbox.modal.run"

# ElevenLabs (optional, user provides own API key via Settings)
# Only needed if server should use a default key for testing
# ELEVENLABS_API_KEY="your-elevenlabs-api-key"
