// Prisma schema for CineGen

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String    @map("password_hash")
  emailVerified Boolean   @default(false) @map("email_verified")
  role          Role      @default(USER)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  apiKeys       ApiKey[]
  characters    Character[]
  projects      Project[]

  @@map("users")
}

enum Role {
  USER
  ADMIN
}

model ApiKey {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  provider     String   // hailuo, kling, nanobanana, 11labs
  encryptedKey String   @map("encrypted_key")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("api_keys")
}

model Character {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  name        String
  description String?
  imageUrl    String?  @map("image_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectCharacters ProjectCharacter[]

  @@map("characters")
}

model Project {
  id              String        @id @default(uuid())
  userId          String        @map("user_id")
  name            String
  status          ProjectStatus @default(DRAFT)
  durationSeconds Int?          @map("duration_seconds")
  genre           String?
  setting         String?
  plot            String?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  // Relations
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectCharacters ProjectCharacter[]
  scenes            Scene[]
  generationJobs    GenerationJob[]

  @@map("projects")
}

enum ProjectStatus {
  DRAFT
  GENERATING
  COMPLETE
  FAILED
}

model ProjectCharacter {
  id              String  @id @default(uuid())
  projectId       String  @map("project_id")
  characterId     String  @map("character_id")
  roleDescription String? @map("role_description")
  voiceId         String? @map("voice_id")

  // Relations
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([projectId, characterId])
  @@map("project_characters")
}

model Scene {
  id             String      @id @default(uuid())
  projectId      String      @map("project_id")
  sequenceNumber Int         @map("sequence_number")
  dialogue       String?
  cameraAngle    String?     @map("camera_angle")
  emotions       String?
  actions        String?
  startImageUrl  String?     @map("start_image_url")
  endImageUrl    String?     @map("end_image_url")
  videoUrl       String?     @map("video_url")
  audioUrl       String?     @map("audio_url")
  status         SceneStatus @default(PENDING)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, sequenceNumber])
  @@map("scenes")
}

enum SceneStatus {
  PENDING
  GENERATING
  COMPLETE
  FAILED
}

model GenerationJob {
  id             String        @id @default(uuid())
  projectId      String        @map("project_id")
  jobType        JobType       @map("job_type")
  status         JobStatus     @default(PENDING)
  progressPercent Int          @default(0) @map("progress_percent")
  errorMessage   String?       @map("error_message")
  startedAt      DateTime?     @map("started_at")
  completedAt    DateTime?     @map("completed_at")

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("generation_jobs")
}

enum JobType {
  IMAGE
  VIDEO
  AUDIO
  COMBINE
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETE
  FAILED
}

model BackgroundMusic {
  id              String @id @default(uuid())
  name            String
  url             String
  durationSeconds Int    @map("duration_seconds")

  @@map("background_music")
}

model VerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  email     String
  type      TokenType
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("verification_tokens")
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}
