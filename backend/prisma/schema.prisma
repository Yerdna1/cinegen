// Prisma schema for CineGen

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // For migrations (bypasses connection pooler)
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String    @map("password_hash")
  emailVerified Boolean   @default(false) @map("email_verified")
  role          String    @default("USER") // USER or ADMIN
  creditBalance Float     @default(0) @map("credit_balance") // Current credit balance
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  apiKeys       ApiKey[]
  characters    Character[]
  projects      Project[]
  preferences   UserPreferences?
  usageRecords  UsageRecord[]

  @@map("users")
}

model UserPreferences {
  id                     String   @id @default(uuid())
  userId                 String   @unique @map("user_id")

  // Default providers for new projects
  defaultLlmProvider     String?  @default("anthropic") @map("default_llm_provider")
  defaultImageProvider   String?  @default("kling") @map("default_image_provider")
  defaultVideoProvider   String?  @default("piapi") @map("default_video_provider")
  defaultVoiceProvider   String?  @default("elevenlabs") @map("default_voice_provider")

  // Default models within providers
  defaultVideoModel      String?  @default("kling-v2-master") @map("default_video_model")
  defaultImageModel      String?  @default("kling-v2") @map("default_image_model")

  // Modal.com endpoints (per-user configuration)
  // Based on actual deployed apps from Modal CLI

  // TTS endpoints
  modalChatterboxEndpoint    String?  @map("modal_chatterbox_endpoint")
  modalCoquiTtsEndpoint      String?  @map("modal_coqui_tts_endpoint")

  // Lip sync / Avatar endpoints
  modalHallo3Endpoint        String?  @map("modal_hallo3_endpoint")

  // Music generation
  modalMusicEndpoint         String?  @map("modal_music_endpoint")

  // Image generation (Flux or other models)
  modalImageEndpoint         String?  @map("modal_image_endpoint")

  // File storage utility
  modalFileS3Endpoint        String?  @map("modal_file_s3_endpoint")

  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model ApiKey {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  provider     String   // hailuo, kling, nanobanana, 11labs, anthropic, modal
  encryptedKey String   @map("encrypted_key")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("api_keys")
}

model Character {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  name        String
  description String?
  imageUrl    String?  @map("image_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectCharacters ProjectCharacter[]

  @@map("characters")
}

model Project {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  name            String
  status          String   @default("DRAFT") // DRAFT, GENERATING, COMPLETE, FAILED
  durationSeconds Int?     @map("duration_seconds")
  genre           String?
  setting         String?
  plot            String?
  llmProvider     String?  @default("anthropic") @map("llm_provider") // anthropic, modal
  imageProvider   String?  @default("kling") @map("image_provider") // kling, nanobanana, piapi, modal
  voiceProvider   String?  @default("elevenlabs") @map("voice_provider") // elevenlabs, modal-f5tts, modal-chatterbox
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectCharacters ProjectCharacter[]
  scenes            Scene[]
  generationJobs    GenerationJob[]

  @@map("projects")
}

model ProjectCharacter {
  id              String  @id @default(uuid())
  projectId       String  @map("project_id")
  characterId     String  @map("character_id")
  roleDescription String? @map("role_description")
  voiceId         String? @map("voice_id")
  voiceProvider   String? @map("voice_provider") // elevenlabs, modal-f5tts, modal-chatterbox
  voiceName       String? @map("voice_name") // Display name of the voice

  // Relations
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([projectId, characterId])
  @@map("project_characters")
}

model Scene {
  id               String   @id @default(uuid())
  projectId        String   @map("project_id")
  sequenceNumber   Int      @map("sequence_number")
  dialogue         String?
  cameraAngle      String?  @map("camera_angle")
  emotions         String?
  actions          String?
  startImagePrompt String?  @map("start_image_prompt")
  endImagePrompt   String?  @map("end_image_prompt")
  startImageUrl    String?  @map("start_image_url")
  endImageUrl      String?  @map("end_image_url")
  videoUrl         String?  @map("video_url")
  audioUrl         String?  @map("audio_url")
  status           String   @default("PENDING") // PENDING, GENERATING, COMPLETE, FAILED
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, sequenceNumber])
  @@map("scenes")
}

model GenerationJob {
  id              String    @id @default(uuid())
  projectId       String    @map("project_id")
  jobType         String    @map("job_type") // IMAGE, VIDEO, AUDIO, COMBINE
  status          String    @default("PENDING") // PENDING, RUNNING, COMPLETE, FAILED
  progressPercent Int       @default(0) @map("progress_percent")
  errorMessage    String?   @map("error_message")
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("generation_jobs")
}

model BackgroundMusic {
  id              String @id @default(uuid())
  name            String
  url             String
  durationSeconds Int    @map("duration_seconds")

  @@map("background_music")
}

model VerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  email     String
  type      String   // EMAIL_VERIFICATION, PASSWORD_RESET
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("verification_tokens")
}

model UsageRecord {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  category      String   // llm, image, video, audio, tts
  provider      String   // anthropic, openai, kling, hailuo, elevenlabs, modal, etc.
  model         String?  // claude-3-opus, gpt-4, etc. (for LLM)
  operation     String   // generate, edit, transcribe, etc.
  inputTokens   Int?     @map("input_tokens")
  outputTokens  Int?     @map("output_tokens")
  totalTokens   Int?     @map("total_tokens")
  imagesCount   Int?     @map("images_count")
  videosCount   Int?     @map("videos_count")
  audioSeconds  Int?     @map("audio_seconds") // Duration in seconds
  cost          Float?   // Estimated cost in credits/dollars
  metadata      String?  // JSON string for extra info
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, category])
  @@index([userId, createdAt])
  @@index([category, provider])
  @@map("usage_records")
}

model GalleryItem {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  mediaType   String   @map("media_type") // IMAGE, VIDEO
  mediaUrl    String   @map("media_url")
  thumbnailUrl String? @map("thumbnail_url")
  prompt      String
  provider    String   @default("kling") // kling, hailuo, etc.
  isPublic    Boolean  @default(true) @map("is_public")
  views       Int      @default(0)
  likes       Int      @default(0)
  taskId      String?  @map("task_id") // External task ID from API
  metadata    String?  // JSON string for extra info (duration, resolution, etc.)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isPublic, createdAt])
  @@index([userId])
  @@map("gallery_items")
}
